{% comment %}
  Custom Banner: top bar (logo / announcement / gift CTA + mobile menu drawer),
  hero with illustration and content, bottom strip.
  All texts marked editable in the brief are exposed in the schema.
{% endcomment %}

{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-banner.js' | asset_url }}" defer></script>

{% style %}
  {{ section.settings.banner_font | font_face: font_display: 'swap' }}
  .section-custom-banner {
    --cb-font-sans: {{ section.settings.banner_font.family }}, {{ section.settings.banner_font.fallback_families }};
  }
{% endstyle %}

<div class="cb" id="CustomBanner-{{ section.id }}">

  <div class="cb__topbar">
    <button
      class="cb__menu"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="CbDrawer-{{ section.id }}"
      data-cb-menu-toggle>
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="cb__logo">{{ section.settings.logo_text | escape }}</a>

    {%- if section.settings.announcement_text != blank -%}
      <p class="cb__announcement">{{ section.settings.announcement_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.gift_label != blank -%}
      <a href="{{ section.settings.gift_link | default: '#' }}" class="cb__btn cb__btn--gift">
        <span class="cb__btn-label">{{ section.settings.gift_label | escape }}</span>
        {%- render 'icon-arrow-right-custom' -%}
      </a>
    {%- endif -%}
  </div>

  {% comment %} Mobile navigation drawer, toggled by the hamburger {% endcomment %}
  <nav class="cb__drawer" id="CbDrawer-{{ section.id }}" data-cb-drawer aria-hidden="true">
    <button class="cb__drawer-close" type="button" aria-label="Close menu" data-cb-menu-close>&times;</button>
    <ul class="cb__drawer-list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}" class="cb__drawer-link">{{ link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
  <div class="cb__drawer-overlay" data-cb-drawer-overlay hidden></div>

  <div class="cb__hero">
    <div class="cb__illustration" role="presentation">
      {%- if section.settings.image_desktop != blank -%}
        <img
          class="cb__illustration-img cb__illustration-img--desktop"
          src="{{ section.settings.image_desktop | image_url: width: 1920 }}"
          srcset="{{ section.settings.image_desktop | image_url: width: 1280 }} 1280w,
                  {{ section.settings.image_desktop | image_url: width: 1920 }} 1920w,
                  {{ section.settings.image_desktop | image_url: width: 2560 }} 2560w"
          sizes="100vw"
          alt=""
          loading="eager"
          width="{{ section.settings.image_desktop.width }}"
          height="{{ section.settings.image_desktop.height }}">
      {%- endif -%}
      {%- if section.settings.image_mobile != blank -%}
        <img
          class="cb__illustration-img cb__illustration-img--mobile"
          src="{{ section.settings.image_mobile | image_url: width: 800 }}"
          alt=""
          loading="eager"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}">
      {%- endif -%}

      {%- if section.settings.shop_label != blank -%}
        <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}"
           class="cb__btn cb__btn--shop cb__btn--shop-mobile">
          <span class="cb__btn-label">{{ section.settings.shop_label | escape }}</span>
          {%- render 'icon-arrow-right-custom' -%}
        </a>
      {%- endif -%}
    </div>

    <div class="cb__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="cb__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="cb__description">{{ section.settings.description }}</div>
      {%- endif -%}
      {%- if section.settings.shop_label != blank -%}
        <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}"
           class="cb__btn cb__btn--shop cb__btn--shop-desktop">
          <span class="cb__btn-label">{{ section.settings.shop_label | escape }}</span>
          {%- render 'icon-arrow-right-custom' -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.strip_text != blank or section.settings.strip_text_mobile != blank -%}
    <div class="cb__strip">
      <p class="cb__strip-text cb__strip-text--desktop">{{ section.settings.strip_text | escape }}</p>
      <p class="cb__strip-text cb__strip-text--mobile">
        {{ section.settings.strip_text_mobile | default: section.settings.strip_text | escape }}
      </p>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-custom-banner",
  "settings": [
    { "type": "header", "content": "Typography" },
    {
      "type": "font_picker",
      "id": "banner_font",
      "label": "Banner font",
      "default": "Jost"
    },
    { "type": "header", "content": "Top bar" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "TISSO VISON" },
    { "type": "text", "id": "announcement_text", "label": "Announcement text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "gift_label", "label": "Gift button label", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "gift_link", "label": "Gift button link" },
    { "type": "link_list", "id": "menu", "label": "Mobile menu", "default": "main-menu" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "image_desktop", "label": "Illustration image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Illustration image (mobile)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    { "type": "text", "id": "shop_label", "label": "Shop button label", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_link", "label": "Shop button link" },
    { "type": "header", "content": "Bottom strip" },
    { "type": "text", "id": "strip_text", "label": "Strip text (desktop)", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" },
    { "type": "text", "id": "strip_text_mobile", "label": "Strip text (mobile)", "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR" }
  ],
  "presets": [{ "name": "Custom Banner" }]
}
{% endschema %}
